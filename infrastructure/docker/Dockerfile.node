# =============================================================================
# GuayCampo - Dockerfile for NestJS services (multi-stage)
# Build arg SERVICE_NAME selects which service to build (auth, shifts, scale, lab, silos)
# =============================================================================

ARG SERVICE_NAME

# -----------------------------------------------------------------------------
# Stage 1: deps — install ALL deps (including dev) for building
# -----------------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app

COPY package*.json turbo.json ./
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/shared-events/package.json packages/shared-events/
COPY packages/database/package.json packages/database/

ARG SERVICE_NAME
COPY services/${SERVICE_NAME}/package.json services/${SERVICE_NAME}/

RUN npm ci

# -----------------------------------------------------------------------------
# Stage 2: builder — compile TypeScript
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app

ARG SERVICE_NAME

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run build --workspace=services/${SERVICE_NAME}

# -----------------------------------------------------------------------------
# Stage 3: prod-deps — only production dependencies
# -----------------------------------------------------------------------------
FROM node:22-alpine AS prod-deps
WORKDIR /app

COPY package*.json turbo.json ./
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/shared-events/package.json packages/shared-events/
COPY packages/database/package.json packages/database/

ARG SERVICE_NAME
COPY services/${SERVICE_NAME}/package.json services/${SERVICE_NAME}/

RUN npm ci --omit=dev

# -----------------------------------------------------------------------------
# Stage 4: runner — minimal final image
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

# Non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001

# Copy built artefacts
COPY --from=builder --chown=nestjs:nodejs /app/services/${SERVICE_NAME}/dist ./dist
COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/packages ./packages

USER nestjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', r => r.statusCode === 200 ? process.exit(0) : process.exit(1))"

CMD ["node", "dist/main.js"]
