# =============================================================================
# .dockerignore — reduce Docker build context
# =============================================================================

# Dependencies (will be installed inside container)
node_modules
**/node_modules

# Build outputs (rebuilt inside container)
dist
**/dist
.next
**/.next
out
**/out

# Coverage and test artifacts
coverage
**/coverage
.nyc_output

# Git
.git
.gitignore
.gitattributes

# Editor / OS
.DS_Store
.idea
.vscode
*.swp
*.swo
Thumbs.db

# Environment files (secrets must never enter Docker context)
.env
.env.*
!.env.example

# CI/CD
.github

# Docs
*.md
docs/

# Logs
*.log
npm-debug.log*

# Terraform state (never in image)
infrastructure/terraform

# Local docker override
infrastructure/docker/docker-compose.override.yml
