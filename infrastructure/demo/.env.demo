# =============================================================================
# GuayCampo - Variables de entorno para DEMO
# Pre-configuradas para demo local — NO usar en producción
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://guaycampo:guaycampo_demo_2024@postgres:5432/guaycampo
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=guaycampo
DATABASE_PASSWORD=guaycampo_demo_2024
DATABASE_NAME=guaycampo

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# JWT — solo para demo, cambiar en producción
# -----------------------------------------------------------------------------
JWT_SECRET=guaycampo-demo-jwt-secret-2024-change-in-production
JWT_REFRESH_SECRET=guaycampo-demo-refresh-secret-2024-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Next Auth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=guaycampo-demo-nextauth-secret-2024-change-in-production

# -----------------------------------------------------------------------------
# URLs de servicios (dentro de la red Docker usan nombre del container)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth:3001
AUTH_SERVICE_HOST=auth
AUTH_SERVICE_PORT=3001
SHIFTS_SERVICE_URL=http://shifts:3002
SHIFTS_SERVICE_HOST=shifts
SHIFTS_SERVICE_PORT=3002
SCALE_SERVICE_URL=http://scale:3003
SCALE_SERVICE_HOST=scale
SCALE_SERVICE_PORT=3003
LAB_SERVICE_URL=http://lab:3004
LAB_SERVICE_HOST=lab
LAB_SERVICE_PORT=3004
SILOS_SERVICE_URL=http://silos:3005
SILOS_SERVICE_HOST=silos
SILOS_SERVICE_PORT=3005
BILLING_SERVICE_URL=http://billing:3006
BILLING_SERVICE_HOST=billing
BILLING_SERVICE_PORT=3006
NOTIFICATIONS_SERVICE_URL=http://notifications:3007
NOTIFICATIONS_SERVICE_HOST=notifications
NOTIFICATIONS_SERVICE_PORT=3007

# -----------------------------------------------------------------------------
# API pública (Kong — accedido desde el browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=http://localhost:3002
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MQTT / EMQX (dentro de la red Docker)
# -----------------------------------------------------------------------------
MQTT_URL=mqtt://emqx:1883
MQTT_WS_URL=ws://emqx:8083/mqtt
MQTT_USERNAME=guaycampo
MQTT_PASSWORD=guaycampo_demo_2024
MQTT_CLIENT_ID=guaycampo-server
MQTT_LOCAL_URL=mqtt://emqx:1883
MQTT_CLOUD_URL=mqtt://emqx:1883

# -----------------------------------------------------------------------------
# Socket.io
# -----------------------------------------------------------------------------
SOCKETIO_CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# WhatsApp (deshabilitado en demo — log en consola)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=console
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# AFIP (modo homologación — sin credenciales reales)
# -----------------------------------------------------------------------------
AFIP_ENVIRONMENT=testing
AFIP_ENABLED=false
AFIP_CERT=
AFIP_KEY=
AFIP_CUIT=30712345678

# -----------------------------------------------------------------------------
# Email (console en demo)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@demo.guaycampo.com

# -----------------------------------------------------------------------------
# Firebase (deshabilitado en demo)
# -----------------------------------------------------------------------------
FIREBASE_ENABLED=false

# -----------------------------------------------------------------------------
# AWS (deshabilitado en demo)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=

# -----------------------------------------------------------------------------
# OCR (deshabilitado en demo)
# -----------------------------------------------------------------------------
OCR_SERVICE_URL=
OCR_API_KEY=

# -----------------------------------------------------------------------------
# Monitoreo
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Kong
# -----------------------------------------------------------------------------
KONG_ADMIN_URL=http://kong:8001
API_GATEWAY_URL=http://kong:8000

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=GuayCampo
APP_VERSION=0.1.0
TZ=America/Argentina/Buenos_Aires
